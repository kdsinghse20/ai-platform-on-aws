[Unit]
Description=Open WebUI Service
After=network.target

[Service]
Type=simple
User={{ openwebui_user }}
Group={{ openwebui_user }}
WorkingDirectory={{ openwebui_home }}
# Configures a clean data folder inside your home path
Environment="DATA_DIR={{ openwebui_home }}/data"
ExecStart={{ openwebui_home }}/venv/bin/open-webui serve --host 127.0.0.1 --port 8080
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
